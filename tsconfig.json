{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "typebox": ["./.pi-host/node_modules/typebox/build/index.d.mts"],
      "typebox/*": ["./.pi-host/node_modules/typebox/build/*"],
      "@earendil-works/*": ["./.pi-host/node_modules/@earendil-works/*"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
