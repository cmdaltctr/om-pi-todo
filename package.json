{
	"name": "pi-todo-openspec",
	"version": "0.1.0",
	"description": "Opinionated modular todo system for Pi, with OpenSpec task sync",
	"keywords": [
		"ompts",
		"openspec",
		"opinionated",
		"pi-extension",
		"pi-package",
		"todo"
	],
	"homepage": "https://github.com/cmdaltctr/ompts-todo#readme",
	"bugs": {
		"url": "https://github.com/cmdaltctr/ompts-todo/issues"
	},
	"license": "MIT",
	"author": "Muhammad Aizat Md Hawari",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cmdaltctr/ompts-todo.git"
	},
	"files": [
		"src",
		"docs/INSTALL.md",
		"docs/USAGE.md",
		"docs/UNINSTALL.md",
		"docs/VERIFICATION.md",
		"CHANGELOG.md",
		"NOTICE.md"
	],
	"type": "module",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"setup:host": "./scripts/setup-host.sh",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"typecheck": "tsc -p .",
		"test": "vitest run",
		"audit": "bun audit",
		"ci": "bun run format:check && bun run lint && bun run typecheck && bun run test",
		"ci:clean": "./scripts/ci-clean.sh",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@types/node": "^26.6.3",
		"husky": "^9.1.7",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22"
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	}
}
