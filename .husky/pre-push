#!/usr/bin/env sh
# Local CI gate. Runs the same steps as .github/workflows/ci.yml.
# Skip once with: git push --no-verify
set -e

# Tests a fresh clone of the committed code, like CI does. Your working folder
# can differ from a clean clone, and that difference has failed CI before.
echo "pre-push: running local CI on a fresh clone (lint, types, tests)"
./scripts/setup-host.sh
bun run ci:clean
